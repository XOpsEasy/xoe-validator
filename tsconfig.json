{
  "compilerOptions": {
    // Type check only: Vite builds the JS, rollup-plugin-dts the declarations.
    "noEmit": true,
    "types": ["node"],
    "target": "ES6",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "esModuleInterop": true,

    // The benchmarks import the built package by name; types come from src.
    "paths": { "@xopseasy/xoe-validator": ["./src/index.ts"] }
  },
  "include": ["src/**/*"],
  "exclude": ["**/tests/**"]
}
