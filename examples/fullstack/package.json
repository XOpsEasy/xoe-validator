{
  "name": "xoe-example-fullstack",
  "private": true,
  "type": "module",
  "description": "A React frontend and a Hono backend sharing xoe-validator schemas.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scenarios.test.ts && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^5.9.2",
    "@xopseasy/xoe-validator": "file:../..",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
